# Backend sozlamalari (nusxa oling: cp .env.example .env)
DATABASE_URL=postgresql+psycopg://omniai:omniai@localhost:5432/omniai
FRONTEND_ORIGIN=http://localhost:3000
# API kalitlarni shifrlash uchun (Fernet). Yaratish:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Sessiya kaliti (majburiy). Yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_DAYS=7
# HTTPS da true
COOKIE_SECURE=false
ALLOW_REGISTRATION=true

# --- Platforma kalitlari (ixtiyoriy) ---
# To'ldirilsa, o'z kaliti bo'lmagan foydalanuvchilar ham ishlay oladi (oylik limit bilan).
PLATFORM_ANTHROPIC_KEY=
PLATFORM_DEEPSEEK_KEY=
PLATFORM_GEMINI_KEY=
FREE_MONTHLY_REQUESTS=100
