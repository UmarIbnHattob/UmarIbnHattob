+/** Grafikdagi boshqa qatorlar (Whisper, OpenRouter, Groq…) uchun qo'shimcha ranglar (globals.css: --s-1…--s-5). */
+const EXTRA_COLORS = ["var(--s-1)", "var(--s-2)", "var(--s-3)", "var(--s-4)", "var(--s-5)"];
